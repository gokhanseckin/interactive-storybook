# iOS simulator. For an Android emulator use http://10.0.2.2:8787.
# A physical device needs the development machine's reachable LAN address.
EXPO_PUBLIC_AUDIO_API_URL=http://127.0.0.1:8787

# Content metadata and signed media delivery. Use a reachable development-machine URL on devices.
EXPO_PUBLIC_CONTENT_API_URL=http://localhost:4400
