{
  "expo": {
    "name": "Masal Yolu",
    "slug": "masal-yolu",
    "version": "1.0.0",
    "scheme": "masalyolu",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masalyolu.spike"
    },
    "android": {
      "package": "com.masalyolu.spike",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Masal seçimlerini sesinle yapabilmen için mikrofon erişimine izin ver.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Masal seçimlerini cihazda anlamak için mikrofon erişimine izin ver.",
          "speechRecognitionPermission": "Ses tanıma yalnızca cihazda çalışır ve masal seçimini anlamak için kullanılır.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ]
  }
}
