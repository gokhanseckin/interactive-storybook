{
  "expo": {
    "name": "Masal Yolu",
    "slug": "masal-yolu",
    "version": "1.0.0",
    "scheme": "masalyolu",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masalyolu.spike",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Ses tan\u0131ma yaln\u0131zca cihazda \u00e7al\u0131\u015f\u0131r ve masal se\u00e7imini anlamak i\u00e7in kullan\u0131l\u0131r.",
        "NSMicrophoneUsageDescription": "Masal se\u00e7imlerini cihazda anlamak i\u00e7in mikrofon eri\u015fimine izin ver.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.masalyolu.spike",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Masal se\u00e7imlerini sesinle yapabilmen i\u00e7in mikrofon eri\u015fimine izin ver.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Masal se\u00e7imlerini cihazda anlamak i\u00e7in mikrofon eri\u015fimine izin ver.",
          "speechRecognitionPermission": "Ses tan\u0131ma yaln\u0131zca cihazda \u00e7al\u0131\u015f\u0131r ve masal se\u00e7imini anlamak i\u00e7in kullan\u0131l\u0131r.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withQuotedBundleScript"
    ],
    "extra": {
      "eas": {
        "projectId": "1b7fb287-f6f6-4aca-91a4-39f097462875"
      }
    },
    "owner": "gokhanseckin"
  }
}
