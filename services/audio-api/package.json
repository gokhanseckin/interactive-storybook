{
  "name": "audio-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live-speech": "node --env-file-if-exists=.env --import tsx src/liveSpeechCheck.ts",
    "generate:hidden-garden-preview": "node --env-file-if-exists=.env --import tsx src/generateHiddenGardenSlice.ts --preview",
    "generate:hidden-garden-slice": "node --env-file-if-exists=.env --import tsx src/generateHiddenGardenSlice.ts"
  },
  "dependencies": {
    "fastify": "^5.12.4",
    "openai": "^7.15.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
